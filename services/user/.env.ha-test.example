# =============================================================================
# Topos user service — HA test environment example
# =============================================================================
# Runs the full user stack (Postgres tripod + Pgpool-II pool + Redis sentinel
# cluster + migrator + service) against the pool, using the SAME compose files
# as production — only this env differs.
#
#   cp .env.ha-test.example .env.ha-test
#   make ha-test-up        # creates the network, builds, starts, migrates
#   make ha-test-stop      # tears everything down (volumes + network)
#
# All containers use the hatest-* prefix so they never clash with a running
# prod stack. The external compose network must be created once; ha-test-up
# does it automatically.
#
# --- Failover / rejoin (semi-auto) ---
# 1. Crash the primary:
#      docker exec hatest-postgres-primary kill -9 $(docker exec hatest-postgres-primary head -1 /bitnami/postgresql/data/postmaster.pid)
#    The pool promotes a replica within seconds; the app never changes URLs.
# 2. Rejoin the old primary: it restarts as a MASTER (bitnami limitation), so
#    recreate it as a replica of the new primary instead:
#      docker rm -f hatest-postgres-primary
#      docker run -d --name hatest-postgres-primary --network topos-user-ha-test \
#        --network-alias user-postgres-primary \
#        -e POSTGRESQL_REPLICATION_MODE=slave -e POSTGRESQL_MASTER_HOST=hatest-postgres-replica-1 \
#        -e POSTGRESQL_REPLICATION_USER=repl_user -e POSTGRESQL_REPLICATION_PASSWORD=<password> \
#        -e POSTGRESQL_USERNAME=toposuser -e POSTGRESQL_PASSWORD=<password> \
#        -e POSTGRESQL_POSTGRES_PASSWORD=<password> -e POSTGRESQL_DATABASE=topos_users \
#        -v topos-user-hatest_user_postgres_primary_data:/bitnami/postgresql bitnami/postgresql:latest
#    Note: bitnami standbys ship without a "host replication" pg_hba entry, so
#    the promoted node cannot accept new replicas until one is added:
#      docker exec hatest-postgres-replica-1 sh -c 'echo "host replication all 0.0.0.0/0 md5" >> /opt/bitnami/postgresql/conf/pg_hba.conf'
#      docker exec -e PGPASSWORD=<password> hatest-postgres-replica-1 psql -w -h 127.0.0.1 -U postgres -tAc "SELECT pg_reload_conf()"
# 3. Re-point the second standby the same way (its master host env still names
#    the old primary), then attach the rejoined nodes in the pool:
#      docker exec -i hatest-postgres-pool /opt/pgpool-II/bin/pcp_attach_node -h 127.0.0.1 -p 9898 -U pcpuser -n 0   # and -n 2
# 4. Verify: SHOW POOL_NODES on the pool shows the promoted node as primary and
#    the rejoined nodes as streaming standbys (lag 0).

# --- Network ----------------------------------------------------------------
APP_NETWORK=topos-user-ha-test

# --- Containers --------------------------------------------------------------
USER_SERVICE_CONTAINER=hatest-user-service
USER_MIGRATOR_CONTAINER=hatest-user-migrator
USER_POSTGRES_PRIMARY_CONTAINER=hatest-postgres-primary
USER_POSTGRES_REPLICA_1_CONTAINER=hatest-postgres-replica-1
USER_POSTGRES_REPLICA_2_CONTAINER=hatest-postgres-replica-2
USER_POSTGRES_POOL_CONTAINER=hatest-postgres-pool
USER_REDIS_MASTER_CONTAINER=hatest-redis-master
USER_REDIS_REPLICA_1_CONTAINER=hatest-redis-replica-1
USER_REDIS_REPLICA_2_CONTAINER=hatest-redis-replica-2
USER_REDIS_SENTINEL_1_CONTAINER=hatest-redis-sentinel-1
USER_REDIS_SENTINEL_2_CONTAINER=hatest-redis-sentinel-2
USER_REDIS_SENTINEL_3_CONTAINER=hatest-redis-sentinel-3

# --- Ports (offset so a prod stack on 4001/5432 can run side by side) --------
USER_SERVICE_EXT_PORT=4101
USER_SERVICE_INT_PORT=4001
USER_POSTGRES_EXT_PORT=5543
USER_POSTGRES_INT_PORT=5432

# --- User Service — authentication ------------------------------------------
# REQUIRED: at least 32 characters
USER_JWT_SECRET=hatest-jwt-secret-0123456789abcdef
USER_JWT_ISSUER=user-service
USER_JWT_AUDIENCE=topos
USER_JWT_EXPIRES_IN=7d

# --- User Service — Postgres -------------------------------------------------
USER_POSTGRES_USER=toposuser
USER_POSTGRES_PASSWORD=<password>
USER_POSTGRES_POSTGRES_PASSWORD=<password>
USER_POSTGRES_DB=topos_users
USER_POSTGRES_REPLICATION_USER=repl_user
USER_POSTGRES_REPLICATION_PASSWORD=<password>
# Pgpool-II PCP admin account (pcp_node_info, pcp_attach_node, ...).
PGPOOL_PCP_USER=pcpuser
PGPOOL_PCP_PASSWORD=<password>
# The app and migrator talk ONLY to the pool. The migrator env below targets
# the pool, BUT migrations are run against the primary directly (see Makefile
# ha-test-up) so Prisma's persistence checks never land on a lagging replica.
USER_DATABASE_URL=postgresql://toposuser:<password>@hatest-postgres-pool:5432/topos_users
USER_DATABASE_URL_REPLICA=postgresql://toposuser:<password>@hatest-postgres-pool:5432/topos_users
USER_DATABASE_URL_MIGRATE=postgresql://toposuser:<password>@hatest-postgres-primary:5432/topos_users

# --- User Service — Redis Sentinel cluster ----------------------------------
USER_REDIS_MASTER_NAME=mymaster
USER_REDIS_SENTINEL_HOSTS=hatest-redis-sentinel-1:26379,hatest-redis-sentinel-2:26379,hatest-redis-sentinel-3:26379
USER_REDIS_PASSWORD=<password>
USER_REDIS_SENTINEL_PASSWORD=<password>

# --- User Service — cache / misc -------------------------------------------
USER_CACHE_TTL_MS=3600000
USER_MISSING_CACHE_TTL_MS=60000
USER_LOG_LEVEL=info
