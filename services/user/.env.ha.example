# =============================================================================
# Topos user service — standalone HA environment example
# =============================================================================
# Runs the full production user stack (Postgres tripod + Pgpool-II pool +
# Redis sentinel cluster + migrator + service) in isolation, using the SAME
# compose files as production — only this env differs.
#
#   cp .env.ha.example .env.ha
#   make ha-up          # creates the network, builds, starts, migrates
#   make ha-down        # tears everything down (volumes + network)
#
# All containers use the userha-* prefix and the dedicated topos-user-ha
# network so they never clash with a root-level prod stack. Host ports match
# production (4001/5432), so the local stack (compose.local.yml) and this HA
# stack are exclusive — only run one at a time.

# --- Network ----------------------------------------------------------------
APP_NETWORK=topos-user-ha

# --- Containers --------------------------------------------------------------
USER_SERVICE_CONTAINER=userha-user-service
USER_MIGRATOR_CONTAINER=userha-user-migrator
USER_POSTGRES_PRIMARY_CONTAINER=userha-postgres-primary
USER_POSTGRES_REPLICA_1_CONTAINER=userha-postgres-replica-1
USER_POSTGRES_REPLICA_2_CONTAINER=userha-postgres-replica-2
USER_POSTGRES_POOL_CONTAINER=userha-postgres-pool
USER_REDIS_MASTER_CONTAINER=userha-redis-master
USER_REDIS_REPLICA_1_CONTAINER=userha-redis-replica-1
USER_REDIS_REPLICA_2_CONTAINER=userha-redis-replica-2
USER_REDIS_SENTINEL_1_CONTAINER=userha-redis-sentinel-1
USER_REDIS_SENTINEL_2_CONTAINER=userha-redis-sentinel-2
USER_REDIS_SENTINEL_3_CONTAINER=userha-redis-sentinel-3

# --- Ports (prod-identical) --------------------------------------------------
USER_SERVICE_EXT_PORT=4001
USER_SERVICE_INT_PORT=4001
USER_POSTGRES_EXT_PORT=5432
USER_POSTGRES_INT_PORT=5432

# --- User Service — authentication ------------------------------------------
# REQUIRED: at least 32 characters
USER_JWT_SECRET=userha-jwt-secret-0123456789abcdef
USER_JWT_ISSUER=user-service
USER_JWT_AUDIENCE=topos
USER_JWT_EXPIRES_IN=7d

# --- User Service — Postgres -------------------------------------------------
USER_POSTGRES_USER=toposuser
USER_POSTGRES_PASSWORD=<password>
USER_POSTGRES_POSTGRES_PASSWORD=<password>
USER_POSTGRES_DB=topos_users
USER_POSTGRES_REPLICATION_USER=repl_user
USER_POSTGRES_REPLICATION_PASSWORD=<password>
# Pgpool-II PCP admin account (pcp_node_info, pcp_attach_node, ...).
PGPOOL_PCP_USER=pcpuser
PGPOOL_PCP_PASSWORD=<password>
# The app and migrator talk ONLY to the pool. The migrator env below targets
# the pool, BUT migrations are run against the primary directly (see Makefile
# ha-up) so Prisma's persistence checks never land on a lagging replica.
USER_DATABASE_URL=postgresql://toposuser:<password>@userha-postgres-pool:5432/topos_users
USER_DATABASE_URL_REPLICA=postgresql://toposuser:<password>@userha-postgres-pool:5432/topos_users
USER_DATABASE_URL_MIGRATE=postgresql://toposuser:<password>@userha-postgres-primary:5432/topos_users

# --- User Service — Redis Sentinel cluster ----------------------------------
USER_REDIS_MASTER_NAME=mymaster
USER_REDIS_SENTINEL_HOSTS=userha-redis-sentinel-1:26379,userha-redis-sentinel-2:26379,userha-redis-sentinel-3:26379
USER_REDIS_PASSWORD=<password>
USER_REDIS_SENTINEL_PASSWORD=<password>

# --- User Service — cache / misc -------------------------------------------
USER_CACHE_TTL_MS=3600000
USER_MISSING_CACHE_TTL_MS=60000
USER_LOG_LEVEL=info