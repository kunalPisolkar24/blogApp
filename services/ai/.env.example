PORT=50051
GRACE_SECONDS=5
METRICS_PORT=12666
LOG_LEVEL=INFO
LLM_API_URL=https://lightning.ai/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=lightning-ai/gpt-oss-20b
LLM_MODE=real
LLM_TIMEOUT_SECONDS=60
# Feed agent: deterministic | agent | fake (agent lets an LLM pick the
# feed blend preset per user; fake scripts it for tests and load runs)
AGENT_MODE=deterministic
AGENT_DECISION_TTL_SECONDS=300
FEED_FRESH_RECENCY_DAYS=14
FEED_EXPLORER_SURPRISE_RATIO=0.3
# LangGraph checkpoint store (Postgres); empty falls back to in-memory.
CHECKPOINT_DB_URL=
CHECKPOINT_STARTUP_RETRIES=12
# LangSmith tracing on LLM calls
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=topos-ai
MAX_POST_CHARS=5000
MAX_INPUT_CHARS=5000
MAX_BODY_CHARS=3000
MAX_TITLE_CHARS=200
# Search / embeddings
EMBEDDING_MODE=fake
EMBEDDING_URL=http://embedding-service:11434
EMBEDDING_MODEL=snowflake-arctic-embed2:568m
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CHARS=8000
EMBEDDING_TIMEOUT_SECONDS=30
VECTOR_MODE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=posts
QDRANT_VECTOR_SIZE=1024
QDRANT_TIMEOUT_SECONDS=10
QDRANT_STARTUP_RETRIES=12
SEARCH_DENSE_SCORE_THRESHOLD=0.3
SEARCH_MAX_RESULT_WINDOW=1000
SEARCH_MAX_QUERY_CHARS=512
SEARCH_MAX_LIMIT=100
RELATED_DEFAULT_LIMIT=10
SPARSE_MIN_TOKEN_LENGTH=2
SPARSE_PREFIX_MIN_LENGTH=3
SPARSE_MAX_TOKENS=512
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-service
# Content service bridge (get_post_body tool); empty token keeps the
# placeholder response.
CONTENT_SERVICE_URL=http://content-service:4002
CONTENT_INTERNAL_TOKEN=
# Evaluation dataset (scripts/build_eval_dataset.py). LANGSMITH_API_KEY
# enables upload to LangSmith; LANGSMITH_PROJECT pulls real chat traces.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
