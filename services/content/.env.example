PORT=4002
MONGO_URI=mongodb://localhost:27017
DB_NAME=blog_content
REDIS_ADDR=localhost:6379
# For a sentinel-managed setup, set REDIS_SENTINELS (comma-separated) and
# REDIS_MASTER_NAME instead of REDIS_ADDR. REDIS_PASSWORD is optional;
# REDIS_SENTINEL_PASSWORD auths to the sentinels and falls back to
# REDIS_PASSWORD when unset.
REDIS_MASTER_NAME=mymaster
REDIS_SENTINELS=
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=
JWT_SECRET=local-dev-secret
AI_SERVICE_URL=ai-service:50051
KAFKA_BROKERS=kafka-1:9092
KAFKA_TOPIC=posts
KAFKA_CONSUMER_GROUP_ID=content-summary-worker-group
KAFKA_SEARCH_CONSUMER_GROUP_ID=content-search-worker-group
KAFKA_DLQ_TOPIC=posts-dlq
WORKER_CONCURRENCY=3
