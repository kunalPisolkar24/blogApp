VITE_GRAPHQL_URL="http://localhost:4000/graphql"
VITE_BACKEND_URL="http://localhost:4000"

# Run the frontend against an in-memory mock backend (no other services).
# Use `npm run dev:mock` which sets this automatically.
VITE_ENABLE_MOCKS="false"

# Any dummy values work in mock mode: uploads are intercepted by MSW and
# replaced with random placeholder images. Set real values for production.
VITE_CLOUDINARY_CLOUD_NAME="mock"
VITE_CLOUDINARY_UPLOAD_PRESET="mock"
